{
  "name": "ESP-IDF + TensorFlow Lite Micro Lab",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "customizations": {
    "vscode": {
      "extensions": [
        "espressif.esp-idf-extension"
      ]
    }
  },
  "remoteUser": "root",
  "postCreateCommand": "bash -lc '. /opt/esp/idf/export.sh && idf.py --version'"
}
